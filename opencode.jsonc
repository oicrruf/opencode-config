{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "model": "minimax/MiniMax-M3",
  "small_model": "minimax/MiniMax-M2.7-highspeed",
  "default_agent": "build",
  "autoupdate": "notify",
  "lsp": true,
  "compaction": { "auto": true },
  "agent": {
    "plan": { "model": "openai/gpt-5.6-terra" },
    "explore": { "model": "openai/gpt-5.6-terra" },
    "adversarial": {
      "model": "openai/gpt-5.6-terra",
      "tools": { "serena*": true, "playwright_*": true }
    },
    "build": {
      "model": "minimax/MiniMax-M3",
      "tools": { "serena*": true }
    },
    "general": { "model": "minimax/MiniMax-M3" },
    "frontend": {
      "model": "minimax/MiniMax-M3",
      "tools": { "playwright_*": true }
    },
    "backend": { "model": "minimax/MiniMax-M3" },
    "qa": {
      "model": "minimax/MiniMax-M3",
      "tools": { "playwright_*": true }
    }
  },
  "tools": {
    "serena*": false,
    "playwright_*": false
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
      "environment": {
        "CODEGRAPH_TELEMETRY": "0"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    },
    "serena": {
      "type": "local",
      "command": ["serena", "start-mcp-server", "--transport", "stdio"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp",
        "--browser",
        "chromium"
      ],
      "enabled": true
    }
  }
}
