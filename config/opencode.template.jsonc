{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": { "*": "ask" },
    "task": "deny",
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "lsp": "allow",
    "skill": {
      "*": "allow",
      "archify": "deny",
      "caveman-commit": "deny",
      "git-workflow": "deny",
      "herdr-integration": "deny",
      "mmx-cli": "deny",
      "mmx-h3-video": "deny",
      "router": "deny",
      "writing-great-skills": "deny"
    }
  },
  "default_agent": "build",
  "autoupdate": "notify",
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 6,
    "preserve_recent_tokens": 4000,
    "reserved": 2000
  },
  "subagent_depth": 1,
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 16384
  },
  "agent": {
    "plan": {
      "steps": 100,
      "permission": {
        "edit": "deny",
        "bash": { "*": "ask" },
        "codegraph_*": "allow",
        "context7_*": "allow"
      }
    },
    "explore": {
      "steps": 25,
      "permission": { "edit": "deny", "bash": "deny", "codegraph_*": "allow" }
    },
    "adversarial": {
      "steps": 100,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "codegraph_*": "allow",
        "context7_*": "allow",
        "playwright_*": "allow"
      }
    },
    "build": {
      "steps": 60,
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "task": "allow",
        "codegraph_*": "allow",
        "context7_*": "allow"
      }
    },
    "general": {
      "steps": 40,
      "permission": {
        "edit": "ask",
        "codegraph_*": "allow",
        "context7_*": "allow"
      }
    },
    "frontend": {
      "steps": 40,
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "codegraph_*": "allow",
        "playwright_*": "allow"
      }
    },
    "backend": {
      "steps": 40,
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "codegraph_*": "allow",
        "context7_*": "allow"
      }
    },
    "qa": {
      "steps": 60,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "codegraph_*": "allow",
        "playwright_*": "allow"
      }
    },
    "cotizador": {
      "steps": 100,
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "allow",
        "codegraph_*": "allow",
        "playwright_*": "allow"
      }
    },
    "refactor": {
      "steps": 100,
      "permission": {
        "edit": "allow",
        "bash": {
          "git *": "allow",
          "gh *": "allow",
          "codegraph *": "allow",
          "openspec *": "allow"
        },
        "external_directory": "allow",
        "codegraph_*": "allow",
        "context7_*": "allow",
        "serena_*": "allow"
      }
    },
    "architect": {
      "steps": 100,
      "permission": {
        "edit": "allow",
        "bash": {
          "codegraph *": "allow",
          "openspec *": "allow",
          "git *": "allow"
        },
        "external_directory": "allow",
        "codegraph_*": "allow",
        "context7_*": "allow"
      }
    },
    "orchestrator": {
      "steps": 100,
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "external_directory": "allow",
        "question": "allow",
        "codegraph_*": "allow",
        "context7_*": "allow"
      }
    },
    "p5t-installer": {
      "steps": 100,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "external_directory": "allow",
        "codegraph_*": "allow",
        "context7_*": "allow"
      }
    },
    "doctor": {
      "steps": 100,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "external_directory": "allow",
        "codegraph_*": "allow",
        "context7_*": "allow"
      }
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
      "environment": {
        "CODEGRAPH_TELEMETRY": "0"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    },
    "serena": {
      "type": "local",
      "command": ["serena", "start-mcp-server", "--transport", "stdio"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.81",
        "--browser",
        "chromium"
      ],
      "enabled": true
    }
  }
}
